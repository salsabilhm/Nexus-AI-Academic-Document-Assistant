# Django
SECRET_KEY=change-me
DEBUG=True
# Hostnames Django serves (Host-header check). Local defaults below; production
# adds the backend's public domain, e.g.
#   ALLOWED_HOSTS=localhost,127.0.0.1,nexus-api.onrender.com
# Hosts derived from CORS_ALLOWED_ORIGINS are accepted automatically (so a
# proxied frontend Host never gets DisallowedHost).
ALLOWED_HOSTS=localhost,127.0.0.1
# Browser origins allowed to call the API (comma-separated). The defaults
# cover the local Vite dev server (it shifts to 5174+ when 5173 is taken) and
# the backend's own origin. Production MUST add the deployed frontend URL:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,...,https://<your-app>.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:8000,http://127.0.0.1:8000
# Optional override: answer any origin instead of the strict list.
# Default = DEBUG (any origin locally, strict list in production).
# CORS_ALLOW_ALL_ORIGINS=

# Supabase PostgreSQL connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Find these in: Supabase dashboard → Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler (port 6543) for Django.
# IMPORTANT: if the password contains special chars (@, :, /, ?, #, [, ], %),
#            percent-encode them first: https://www.urlencoder.org/
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Storage
# Find these in: Supabase dashboard → Project Settings → API
# SUPABASE_URL      — e.g. https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY — service_role key (keep secret, never expose to frontend)
# SUPABASE_STORAGE_BUCKET   — name of the storage bucket (e.g. "documents")
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Future AI services — placeholders only, never commit real keys
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_API_KEY=

# Nexus agent LLM (Google Gemini) — read by chatbot/services/agent/llm.py
# GEMINI_API_KEY  — Google AI Studio key (required to answer questions)
# GEMINI_MODEL    — Gemini model id, e.g. gemini-2.5-flash (required)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# RAG retrieval — read by chatbot/rag/service.py (applies to every retrieve())
# RAG_SIMILARITY_THRESHOLD — minimum cosine similarity (score = 1 - distance,
#   range [-1, 1]) a chunk must reach to be returned. Fewer than top_k results
#   are returned when fewer chunks pass. Default 0.03; set "off" to disable.
RAG_SIMILARITY_THRESHOLD=0.03

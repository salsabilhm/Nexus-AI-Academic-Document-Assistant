# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Supabase PostgreSQL connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Find these in: Supabase dashboard → Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler (port 6543) for Django.
# IMPORTANT: if the password contains special chars (@, :, /, ?, #, [, ], %),
#            percent-encode them first: https://www.urlencoder.org/
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Supabase Storage
# Find these in: Supabase dashboard → Project Settings → API
# SUPABASE_URL      — e.g. https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY — service_role key (keep secret, never expose to frontend)
# SUPABASE_STORAGE_BUCKET   — name of the storage bucket (e.g. "documents")
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# Future AI services — placeholders only, never commit real keys
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_API_KEY=

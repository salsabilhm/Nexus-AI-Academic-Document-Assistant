# Backend API base URL used by the Axios client (see src/services/api.ts)
#
# Local development: OPTIONAL — when unset, src/services/api.ts falls back to
#   http://localhost:8000/api, so `npm run dev` works without this file
#   (copy this file to .env to override; restart `npm run dev` after changes).
#
# Production: REQUIRED — Vite inlines this at BUILD time, so set it in the
#   hosting platform (e.g. Vercel → Project → Settings → Environment
#   Variables), then REDEPLOY (not just restart). It must point at the
#   deployed Django API and include the /api prefix:
#     VITE_API_BASE_URL=https://<backend-host>/api
#   Same-origin option: if your host proxies /api/* to the backend
#   (e.g. Vercel rewrites), you can use the relative value `/api`.
VITE_API_BASE_URL=http://localhost:8000/api
